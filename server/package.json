{
  "name": "@ideenportal/server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:learning": "tsx src/db/learning-data.ts",
    "jobs": "tsx src/jobs/run-once.ts",
    "identity": "tsx src/db/identity-cli.ts",
    "rotate-key": "tsx src/db/rotate-key.ts",
    "operator": "tsx src/db/operator-cli.ts",
    "loadtest": "tsx src/db/loadtest.ts",
    "test": "vitest run",
    "eval": "tsx src/ai/eval-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.7",
    "@node-saml/node-saml": "^5.2.0",
    "@xmldom/xmldom": "^0.8.15",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "read-excel-file": "^9.3.13",
    "undici": "^8.11.2",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "xml-crypto": "^6.4.0"
  }
}
