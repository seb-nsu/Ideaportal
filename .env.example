# Copy to .env or set in the environment. Never commit real secrets.
DATABASE_URL=postgres://ideenportal:ideenportal@localhost:5432/ideenportal
PORT=3000
PUBLIC_URL=http://localhost:3000
# true behind HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12
JOB_INTERVAL_MINUTES=15
# log | none | smtp. With SMTP_URL set, smtp is the default.
MAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Ideenportal <no-reply@example.com>
MIGRATE_ON_START=true
# Self-service: sign-up of new workspaces (default true) and the public demo with role switch (default false)
SIGNUP_ENABLED=true
DEMO_MODE=false
# SECRET_KEY encrypts AI keys per workspace and TOTP secrets; required in production.
# SECRET_KEY=change-me-to-a-long-random-value
# Platform keys that workspaces may use instead of their own
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# BRAVE_API_KEY=
# Allow provider URLs in the private network (e.g. Ollama on localhost); only for self-hosting
AI_ALLOW_PRIVATE_URLS=false
AI_WORKER_SECONDS=5
AI_TIMEOUT_SECONDS=300
# Optional virus scan of attachments with ClamAV (clamd)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# Rate limits (R1-44): factor for all limits, 0 switches them off (load tests only)
RATE_LIMIT_FACTOR=1
# Number of reverse proxies in front of the app; 0 without a proxy
TRUST_PROXY_HOPS=1
